# Pour le web (app servie depuis le même serveur) :
#   - Laissez VIDE → auto-détection via window.location.origin
#
# Pour l'application native (APK installé sur téléphone) :
#   - Définir EXPO_PUBLIC_API_URL avec l'IP du serveur
#   - Exemple: EXPO_PUBLIC_API_URL=http://192.168.1.100:8000

# Backend API URL
EXPO_PUBLIC_API_URL=
